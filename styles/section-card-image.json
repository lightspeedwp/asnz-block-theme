{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-card-image",
  "title": "Card Image Section",
  "blockTypes": ["core/group"],
  "styles": {
    "border": {
      "radius": "8px 8px 0 0"
    },
    "blocks": {
      "core/post-featured-image": {
        "border": {
          "radius": {
            "topLeft": "8px",
            "topRight": "8px"
          }
        },
        "css": "width: 100%; object-fit: cover; aspect-ratio: 21 / 9;"
      }
    }
  }
}
