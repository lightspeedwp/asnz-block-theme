{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-breadcrumbs",
  "title": "Breadcrumbs Section",
  "blockTypes": ["core/group"],
  "styles": {
    "color": {
      "text": "var:preset|color|brand-dark",
      "background": "var:preset|color|primary-light"
    },
    "spacing": {
      "padding": {
        "top": "var:preset|spacing|10",
        "bottom": "var:preset|spacing|10"
      },
      "margin": {
        "top": "0px",
        "bottom": "0px"
      },
      "blockGap": "var:preset|spacing|20"
    },
    "typography": {
      "fontWeight": "500"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|brand-dark"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|brand-dark"
          }
        }
      }
    }
  }
}
