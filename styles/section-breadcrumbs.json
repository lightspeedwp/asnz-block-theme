{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-breadcrumbs",
  "title": "Breadcrumbs Section",
  "blockTypes": ["core/group"],
  "styles": {
    "color": {
      "text": "var:preset|color|primary-700",
      "background": "var:preset|color|tertiary-100"
    },
    "spacing": {
      "padding": {
        "top": "var:preset|spacing|spacing-10",
        "bottom": "var:preset|spacing|spacing-10"
      },
      "blockGap": "var:preset|spacing|spacing-20"
    },
    "typography": {
      "fontWeight": "500"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|primary-700"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|primary-800"
          }
        }
      }
    }
  }
}
