{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-hero",
  "title": "Hero Section",
  "blockTypes": ["core/group"],
  "styles": {
    "spacing": {
      "blockGap": "var:preset|spacing|spacing-20"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontSize": "var:preset|font-size|font-size-800"
        },
        "color": {
          "text": "var:preset|color|base"
        }
      }
    }
    ,
    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontSize": "var:preset|font-size|font-size-400",
          "fontWeight": "600"
        }
      }
    }
  }
}