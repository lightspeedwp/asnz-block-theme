{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-top-header",
  "title": "Top Header",
  "blockTypes": ["core/group"],
  "styles": {
    "color": {
      "background": "var:preset|color|primary-800",
      "text": "var:preset|color|base"
    },
    "spacing": {
      "padding": {
        "right": "var:preset|spacing|spacing-0",
        "left": "var:preset|spacing|spacing-0"
      },
      "blockGap": "var:preset|spacing|spacing-20"
    },
    "elements": {
      "link": {
        "typography": {
          "fontSize": "var:preset|font-size|font-size-200",
          "fontWeight": "500",
          "textDecoration": "none"
        },
        "color": {
          "text": "var:preset|color|base"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|cta-500"
          },
          "typography": {
            "textDecoration": "none"
          }
        }
      }
    }
  }
}