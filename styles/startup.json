{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Startup",
	"settings": {
		"color": {}
	},
	"styles": {
		"elements": {
			"button": {
				"spacing": {
					"padding": {
						"top": ".6em",
						"right": "1.4em",
						"bottom": ".6em",
						"left": "1.4em"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--expanded)",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--line-height--snug)",
					"fontSize": "var(--wp--preset--font-size--font-size-500)"
				}
			}
		}
	}
}
