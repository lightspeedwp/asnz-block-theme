{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Brand",
    "slug": "button-brand",
    "blockTypes": ["core/button"],
    "styles": {
        "border": {
            "radius": "4px"
        },
        "spacing": {
            "padding": {
                "top": "6px",
                "bottom": "6px"
            }
        },
        "color": {
            "background": "var:preset|color|brand",
            "text": "var:preset|color|base"
        },
        "typography": {
            "fontFamily": "var:preset|font-family|primary",
            "fontSize": "var:preset|font-size|400",
            "fontWeight": "500"
        }
    }
}
