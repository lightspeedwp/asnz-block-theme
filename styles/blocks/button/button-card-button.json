{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Card Button",
  "slug": "card-button",
  "blockTypes": ["core/button"],
  "styles": {
    "border": {
      "radius": "0 0 8px 8px"
    },
    "spacing": {
      "padding": {
        "top": "6px",
        "bottom": "8px"
      }
    },
    "color": {
      "background": "var:preset|color|primary-500",
      "text": "var:preset|color|base"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|primary",
      "fontSize": "var:preset|font-size|font-size-300",
      "fontWeight": "500"
    }
  }
}
