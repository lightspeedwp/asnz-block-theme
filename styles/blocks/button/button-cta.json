{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "CTA",
  "slug": "button-cta",
  "blockTypes": ["core/button"],
  "styles": {
    "border": {
      "radius": "4px"
    },
    "spacing": {
      "padding": {
        "top": "6px",
        "bottom": "6px"
      }
    },
    "color": {
      "background": "var:preset|color|cta-500",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|primary",
      "fontSize": "var:preset|font-size|font-size-400",
      "fontWeight": "400"
    }
  }
}
