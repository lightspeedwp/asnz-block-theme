{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Top Header",
  "slug": "button-top-header",
  "blockTypes": ["core/button"],
  "styles": {
    "border": {
      "radius": "0"
    },
    "spacing": {
      "padding": {
        "top": "6px",
        "bottom": "8px"
      }
    },
    "color": {
      "background": "var:preset|color|cta-500",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|primary",
      "fontSize": "var:preset|font-size|font-size-300",
      "fontWeight": "500"
    }
  }
}
