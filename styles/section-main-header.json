{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-main-header",
  "title": "Main Header",
  "blockTypes": ["core/group"],
  "styles": {
    "spacing": {
      "blockGap": "var:preset|spacing|20"
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "fontWeight": "500",
          "fontSize": "var:preset|font-size|300"
        },
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "none"
              }
            }
          }
        }
      }
    }
  }
}
