{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-card",
  "title": "Card",
  "blockTypes": ["core/group"],
  "styles": {
    "color": {
      "background": "var:preset|color|neutral-100",
      "text": "var:preset|color|neutral-800"
    },
    "border": {
      "radius": "8px"
    },
    "spacing": {
  "blockGap": "var:preset|spacing|spacing-10"
    },
  "shadow": "var:preset|shadow|elevation-1",
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "600"
        }
      }
    }
  }
}
