{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-facts-panel",
  "title": "Facts Panel",
  "blockTypes": ["core/group"],
  "styles": {
    "spacing": {
      "padding": {
        "top": "var:preset|spacing|spacing-10",
        "bottom": "var:preset|spacing|spacing-10",
        "left": "var:preset|spacing|spacing-10",
        "right": "var:preset|spacing|spacing-10"
      },
      "blockGap": "var:preset|spacing|spacing-10"
    },
    "border": {
      "radius": "8px",
      "width": "3px",
      "color": "var:preset|color|primary-700"
    },
    "color": {
      "background": "var:preset|color|primary-bg"
    }
  }
}
