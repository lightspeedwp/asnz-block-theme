{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-footer",
  "title": "Footer Section",
  "blockTypes": ["core/group"],
  "styles": {
    "color": {
      "background": "var:preset|color|primary-100",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontWeight": "500"
    },
    "spacing": {
      "padding": {
        "top": "var:preset|spacing|spacing-60",
        "right": "var:preset|spacing|spacing-30",
        "bottom": "var:preset|spacing|spacing-0",
        "left": "var:preset|spacing|spacing-30"
      },
      "blockGap": "var:preset|spacing|spacing-60"
    },
    "border": {
      "top": {
        "color": "var:preset|color|tertiary-800",
        "width": "1px",
        "style": "solid"
      }
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|primary-700" },
        "typography": { "fontWeight": "500", "textDecoration": "none" },
        ":hover": {
          "color": { "text": "var:preset|color|cta-500" },
          "typography": { "textDecoration": "underline" }
        }
      },
      "heading": {
        "color": { "text": "var:preset|color|primary-700" },
        "typography": {
          "fontSize": "var:preset|font-size|font-size-500",
          "fontWeight": "600"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|font-size-300",
          "fontWeight": "500"
        },
        "spacing": { "blockGap": "var:preset|spacing|spacing-20" }
      }
    }
  }
}
