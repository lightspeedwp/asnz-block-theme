{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "section-post-tags",
  "title": "Post Tags Section",
  "blockTypes": ["core/group"],
  "styles": {
    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontSize": "var:preset|font-size|400",
          "fontWeight": "600"
        },
        "color": {
          "text": "var:preset|color|contrast"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|400",
          "fontWeight": "600"
        },
        "color": {
          "text": "var:preset|color|brand"
        },
        "elements": {
          "link": {
            "color": { "text": "var:preset|color|brand" },
            ":hover": {
              "color": { "text": "var:preset|color|brand-dark" },
              "typography": { "textDecoration": "underline" }
            }
          }
        }
      }
    }
  }
}
