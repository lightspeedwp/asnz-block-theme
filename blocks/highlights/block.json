{
    "apiVersion": 3,
    "name": "asnz/highlights",
    "title": "Highlights",
    "category": "widgets",
    "icon": "star-filled",
    "description": "Displays highlights heading and text from SCF fields.",
    "keywords": ["highlights", "scf", "heading"],
    "supports": {
        "html": false,
        "customClassName": true
    },
    "attributes": {
        "headingField": {
            "type": "string",
            "default": "asnz_highlights_heading"
        },
        "textField": {
            "type": "string",
            "default": "asnz_highlights_text"
        }
    },
    "version": "1.0.0",
    "textdomain": "asnz-block-theme",
    "editorScript": "file:./build/index.js",
    "render": "file:./render.php"
}
