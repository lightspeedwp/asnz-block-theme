				{ "name": "Base 600", "slug": "base-600", "color": "#f0f0f0" },
				{ "name": "Base 700", "slug": "base-700", "color": "#d0d0d0" },
				{ "name": "Contrast 500", "slug": "contrast-500", "color": "#565656" },
				{ "name": "Contrast 600", "slug": "contrast-600", "color": "#080808" },
				{ "name": "Contrast 700", "slug": "contrast-700", "color": "#070707" },
				{ "name": "Contrast 900", "slug": "contrast-900", "color": "#090909" },
				{ "name": "Neutral 300", "slug": "neutral-300", "color": "#e4e4e4" },
				{ "name": "Neutral 500", "slug": "neutral-500", "color": "#bebebe" },
				{ "name": "CTA 100", "slug": "cta-100", "color": "#fff5eb" },
				{ "name": "CTA 500", "slug": "cta-500", "color": "#f7941c" },
				{ "name": "CTA 600", "slug": "cta-600", "color": "#e68012" },
				{ "name": "CTA 700", "slug": "cta-700", "color": "#cb700f" },
				{ "name": "Primary 100", "slug": "primary-100", "color": "#f0f9eb" },
				{ "name": "Primary 200", "slug": "primary-200", "color": "#d8efca" },
				{ "name": "Primary 300", "slug": "primary-300", "color": "#b7e296" },
				{ "name": "Primary 500", "slug": "primary-500", "color": "#388d03" },
				{ "name": "Primary 700", "slug": "primary-700", "color": "#286902" },
				{ "name": "Primary 800", "slug": "primary-800", "color": "#1f5601" },
				{ "name": "Primary 900", "slug": "primary-900", "color": "#102800" },
				{ "name": "Secondary 100", "slug": "secondary-100", "color": "#f3fbff" },
				{ "name": "Secondary 500", "slug": "secondary-500", "color": "#1a8ad4" },
				{ "name": "Secondary 900", "slug": "secondary-900", "color": "#0a3d62" },
				{ "name": "Tertiary 100", "slug": "tertiary-100", "color": "#f8f7f5" },
				{ "name": "Tertiary 300", "slug": "tertiary-300", "color": "#dedacf" },
				{ "name": "Tertiary 500", "slug": "tertiary-500", "color": "#b7ac91" },
				{ "name": "Tertiary 700", "slug": "tertiary-700", "color": "#8c8265" },
				{ "name": "Tertiary 800", "slug": "tertiary-800", "color": "#736a53" },
				{ "name": "Tertiary 900", "slug": "tertiary-900", "color": "#514b3a" },
				{ "name": "Quaternary 100", "slug": "quaternary-100", "color": "#f8f7f5" },
				{ "name": "Quaternary 200", "slug": "quaternary-200", "color": "#efede8" },
				{ "name": "Quaternary 300", "slug": "quaternary-300", "color": "#dedacf" },
				{ "name": "Quaternary 400", "slug": "quaternary-400", "color": "#ccc4b3" },
				{ "name": "Quaternary 500", "slug": "quaternary-500", "color": "#ac9f7c" },
				{ "name": "Quaternary 700", "slug": "quaternary-700", "color": "#8c8265" },
				{ "name": "Quaternary 800", "slug": "quaternary-800", "color": "#736a53" },
				{ "name": "Quaternary 900", "slug": "quaternary-900", "color": "#514b3a" }

				,
				{ "name": "Base (Alias)", "slug": "base", "color": "#ffffff" },
				{ "name": "Main (Alias)", "slug": "main", "color": "#080808" },
				{ "name": "Tertiary (Alias)", "slug": "tertiary", "color": "#b7ac91" }
			],
			"link": true
		},
		"shadow": {
			"defaultPresets": false,
            "presets": [
                {
                    "name": "Extra Large Dark",
                    "slug": "extra-large-dark",
                    "shadow": "0px 536px 150px 0px rgba(20, 17, 31, 0.00), 0px 343px 137px 0px rgba(20, 17, 31, 0.01), 0px 193px 116px 0px rgba(20, 17, 31, 0.05), 0px 86px 86px 0px rgba(20, 17, 31, 0.09), 0px 21px 47px 0px rgba(20, 17, 31, 0.10)"
                },
				{
                    "name": "Large Dark",
                    "slug": "large-dark",
                    "shadow": "0px 219px 61px 0px rgba(20, 17, 31, 0.00), 0px 140px 56px 0px rgba(20, 17, 31, 0.01), 0px 79px 47px 0px rgba(20, 17, 31, 0.05), 0px 35px 35px 0px rgba(20, 17, 31, 0.09), 0px 9px 19px 0px rgba(20, 17, 31, 0.10)"
                },
				{
                    "name": "Medium Dark",
                    "slug": "medium-dark",
                    "shadow": "0px 66px 18px 0px rgba(20, 17, 31, 0.00), 0px 42px 17px 0px rgba(20, 17, 31, 0.01), 0px 24px 14px 0px rgba(20, 17, 31, 0.05), 0px 10px 10px 0px rgba(20, 17, 31, 0.09), 0px 3px 6px 0px rgba(20, 17, 31, 0.10)"
                },
				{
                    "name": "Small Dark",
                    "slug": "small-dark",
                    "shadow": "0px 16px 4px 0px rgba(20, 17, 31, 0.00), 0px 10px 4px 0px rgba(20, 17, 31, 0.01), 0px 6px 3px 0px rgba(20, 17, 31, 0.05), 0px 3px 3px 0px rgba(20, 17, 31, 0.09), 0px 1px 1px 0px rgba(20, 17, 31, 0.10)"
                },
				{
                    "name": "Extra Large Light",
                    "slug": "extra-large-light",
                    "shadow": "0px 536px 150px 0px rgba(20, 17, 31, 0.00), 0px 343px 137px 0px rgba(20, 17, 31, 0.01), 0px 193px 116px 0px rgba(20, 17, 31, 0.03), 0px 86px 86px 0px rgba(20, 17, 31, 0.04), 0px 21px 47px 0px rgba(20, 17, 31, 0.05)"
                },
				{
                    "name": "Large Light",
                    "slug": "large-light",
                    "shadow": "0px 219px 61px 0px rgba(20, 17, 31, 0.00), 0px 140px 56px 0px rgba(20, 17, 31, 0.01), 0px 79px 47px 0px rgba(20, 17, 31, 0.03), 0px 35px 35px 0px rgba(20, 17, 31, 0.04), 0px 9px 19px 0px rgba(20, 17, 31, 0.05)"
                },
				{
                    "name": "Medium Light",
                    "slug": "medium-light",
                    "shadow": "0px 69px 19px 0px rgba(20, 17, 31, 0.00), 0px 44px 18px 0px rgba(20, 17, 31, 0.01), 0px 25px 15px 0px rgba(20, 17, 31, 0.03), 0px 11px 11px 0px rgba(20, 17, 31, 0.04), 0px 3px 6px 0px rgba(20, 17, 31, 0.05)"
                },
				{
                    "name": "Small Light",
                    "slug": "small-light",
                    "shadow": "0px 16px 5px 0px rgba(20, 17, 31, 0.00), 0px 10px 4px 0px rgba(20, 17, 31, 0.00), 0px 6px 4px 0px rgba(20, 17, 31, 0.02), 0px 3px 3px 0px rgba(20, 17, 31, 0.03), 0px 1px 1px 0px rgba(20, 17, 31, 0.03)"
                }
            ]
        },
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "spacing-10", "size": "clamp(0.45rem, 0.9vw, 0.625rem)", "name": "Tiny" },
				{ "slug": "spacing-20", "size": "clamp(0.9rem, 1.4vw, 1.25rem)", "name": "Small" },
				{ "slug": "spacing-30", "size": "clamp(1.2rem, 1.9vw, 1.875rem)", "name": "Medium" },
				{ "slug": "spacing-40", "size": "clamp(1.6rem, 2.5vw, 2.5rem)", "name": "Large" },
				{ "slug": "spacing-50", "size": "clamp(2rem, 3vw, 3.125rem)", "name": "X-Large" },
				{ "slug": "spacing-60", "size": "clamp(2.3rem, 3.5vw, 3.75rem)", "name": "Huge" },
				{ "slug": "spacing-70", "size": "clamp(2.6rem, 4.2vw, 4.375rem)", "name": "Gigantic" },
				{ "slug": "spacing-80", "size": "clamp(3rem, 5vw, 5rem)", "name": "Colossal" }
			],
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"blockGap": true,
			"padding": true,
			"margin": true
		},
		"typography": {
			"dropCap": false,
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"fontFamily": "Lato, sans-serif",
					"name": "Primary (Lato)",
					"slug": "primary",
					"fontFace": [
						{ "fontFamily": "Lato", "fontWeight": "100", "fontStyle": "normal", "src": ["file:./assets/fonts/lato/Lato-Thin.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Lato", "fontWeight": "100", "fontStyle": "italic", "src": ["file:./assets/fonts/lato/Lato-ThinItalic.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Lato", "fontWeight": "300", "fontStyle": "normal", "src": ["file:./assets/fonts/lato/Lato-Light.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Lato", "fontWeight": "300", "fontStyle": "italic", "src": ["file:./assets/fonts/lato/Lato-LightItalic.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Lato", "fontWeight": "400", "fontStyle": "normal", "src": ["file:./assets/fonts/lato/Lato-Regular.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Lato", "fontWeight": "400", "fontStyle": "italic", "src": ["file:./assets/fonts/lato/Lato-Italic.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Lato", "fontWeight": "700", "fontStyle": "normal", "src": ["file:./assets/fonts/lato/Lato-Bold.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Lato", "fontWeight": "700", "fontStyle": "italic", "src": ["file:./assets/fonts/lato/Lato-BoldItalic.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Lato", "fontWeight": "900", "fontStyle": "normal", "src": ["file:./assets/fonts/lato/Lato-Black.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Lato", "fontWeight": "900", "fontStyle": "italic", "src": ["file:./assets/fonts/lato/Lato-BlackItalic.ttf"], "fontDisplay": "swap" }
					]
				},
				{
					"fontFamily": "'Source Sans Pro', 'Source Sans 3', sans-serif",
					"name": "Secondary (Source Sans Pro)",
					"slug": "secondary",
					"fontFace": [
						{ "fontFamily": "Source Sans Pro", "fontWeight": "200 900", "fontStyle": "normal", "src": ["file:./assets/fonts/source-sans-pro/SourceSans3-VariableFont_wght.ttf"], "fontDisplay": "swap" },
						{ "fontFamily": "Source Sans Pro", "fontWeight": "200 900", "fontStyle": "italic", "src": ["file:./assets/fonts/source-sans-pro/SourceSans3-Italic-VariableFont_wght.ttf"], "fontDisplay": "swap" }
					]
				},
				{
					"fontFamily": "SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace",
					"name": "Monospace",
					"slug": "monospace"
				}
			],
			"fontSizes": [
				{ "slug": "font-size-100", "size": "0.75rem", "name": "Tiny", "fluid": { "min": "0.7rem", "max": "0.75rem" } },
				{ "slug": "font-size-200", "size": "1rem", "name": "Base", "fluid": { "min": "0.95rem", "max": "1rem" } },
				{ "slug": "font-size-300", "size": "1.25rem", "name": "Small", "fluid": { "min": "1.1rem", "max": "1.25rem" } },
				{ "slug": "font-size-400", "size": "1.5rem", "name": "Medium", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "font-size-500", "size": "2rem", "name": "Large", "fluid": { "min": "1.6rem", "max": "2rem" } },
				{ "slug": "font-size-600", "size": "2.5rem", "name": "X-Large", "fluid": { "min": "2.1rem", "max": "2.5rem" } },
				{ "slug": "font-size-700", "size": "3rem", "name": "Huge", "fluid": { "min": "2.4rem", "max": "3rem" } },
				{ "slug": "font-size-800", "size": "4rem", "name": "Gigantic", "fluid": { "min": "3.1rem", "max": "4rem" } },
				{ "slug": "font-size-900", "size": "5rem", "name": "Colossal", "fluid": { "min": "3.5rem", "max": "5rem" } }
			],
			"lineHeight": true
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/code": {
				"border": {
					"radius": "5px",
					"width": "0px"
				},
				"color": {
					"background": "var:preset|color|tertiary",
					"text": "var:preset|color|main"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|spacing-20",
						"right": "var:preset|spacing|spacing-20",
						"bottom": "var:preset|spacing|spacing-20",
						"left": "var:preset|spacing|spacing-20"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|monospace",
					"fontSize": "var:preset|font-size|font-size-200"
				}
			},
			"core/comment-author-name": {
				"typography": {
					"lineHeight": "1.5",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none",
							"fontSize": "var:preset|font-size|font-size-300"
						}
					}
				}
			},
			"core/comment-content": {
				"spacing": {
					"margin": {
						"top": "20px !important"
					}
				}
			},
			"core/comment-date": {
				"typography": {
					"fontSize": "var:preset|font-size|font-size-200",
					"lineHeight": "1.5"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/comment-edit-link": {
				"typography": {
					"fontSize": "var:preset|font-size|font-size-200",
					"lineHeight": "1.5"
				}
			},
			"core/comment-reply-link": {
				"typography": {
					"fontSize": "var:preset|font-size|font-size-200"
				}
			},
			"core/comments-title": {
				"spacing": {
					"margin": {
						"top": "0px",
						"bottom": "var:preset|spacing|spacing-40"
					}
				}
			},
			"core/details": {
				"css": ".wp-block-details summary { font-weight: 600 }"
			},
			"core/post-comments-form": {
				"elements": {
					"heading": {
						"typography": {
							"fontSize": "var:preset|font-size|font-size-400"
						}
					}
				}
			},
			"core/read-more": {
				"elements": {
					"link": {
						"spacing": {
							"margin": {
								"top": "200px",
								"bottom": "200px"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/paragraph": {
				"css": "&.has-background { padding: var(--wp--preset--spacing--spacing-10) }"
			},
			"core/post-template": {
				"elements": {
					"h2": {
						"typography": {
							"fontSize": "var:preset|font-size|font-size-400"
						}
					}
				}
			},
			"core/post-terms": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/preformatted": {
				"border": {
					"radius": "5px"
				},
				"color": {
					"background": "var:preset|color|tertiary",
					"text": "var:preset|color|main"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|spacing-20",
						"right": "var:preset|spacing|spacing-20",
						"bottom": "var:preset|spacing|spacing-20",
						"left": "var:preset|spacing|spacing-20"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|monospace",
					"fontSize": "var:preset|font-size|font-size-200"
				}
			},
			"core/pullquote": {
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var:preset|font-size|font-size-200"
						},
						"color": {
							"text": "var:preset|color|secondary"
						}
					}
				},
				"border": {
					"color": "var:preset|color|primary",
					"top": {
						"style": "solid",
						"width": "5px"
					}
				},
				"spacing": {
					"padding": {
						"top": "0",
						"right": "0",
						"bottom": "0",
						"left": "0"
					}
				},
				"typography": {
					"lineHeight": "1.5",
					"fontSize": "var:preset|font-size|font-size-400",
					"fontWeight": "500"
				}
			},
			"core/query-pagination": {
				"elements": {
					"link": {
						"border": {
							"radius": "5px",
							"width": "0"
						},
						"color": {
							"background": "var:preset|color|base"
						},
						"spacing": {
							"padding": {
								"top": ".5em",
								"right": "1em",
								"bottom": ".5em",
								"left": "1em"
							}
						},
						"typography": {
							"fontSize": "var:preset|font-size|font-size-200",
							"fontWeight": "500",
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/quote": {
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var:preset|font-size|font-size-200"
						},
						"color": {
							"text": "var:preset|color|secondary"
						}
					}
				},
				"css": "& :where(cite) { display: block }",
				"border": {
					"radius": "0",
					"style": "solid",
					"width": "0 0 0 5px !important",
					"color": "var:preset|color|primary"
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|spacing-40",
						"right": "var:preset|spacing|spacing-40"
					},
					"margin": {
						"left": "0"
					}
				},
				"typography": {
					"lineHeight": "1.5",
					"fontSize": "var:preset|font-size|font-size-400",
					"fontWeight": "500"
				}
			},
			"core/search": {
				"css": ".wp-block-search__button-inside .wp-block-search__inside-wrapper { border: none }"
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|main"
				}
			},
			"core/site-tagline": {
				"spacing": {
					"margin": {
						"bottom": "20px"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|font-size-200"
				}
			},
			"core/site-title": {
				"typography": {
						"fontSize": "var:preset|font-size|font-size-300",
					"fontWeight": "600",
					"lineHeight": "var:custom|line-height|none",
					"letterSpacing": "0"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
