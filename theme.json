{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [
				{ "name": "Blue", "slug": "blue", "colors": ["#462CFF", "#ECE8FF"] },
				{ "name": "Pink", "slug": "Pink", "colors": ["#F22AAA", "#FFDBF0"] },
				{ "name": "Green", "slug": "green", "colors": ["#196A64", "#E0FFFD"] },
